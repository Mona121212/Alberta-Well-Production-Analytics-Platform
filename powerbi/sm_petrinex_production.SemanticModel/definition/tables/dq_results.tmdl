table dq_results
	lineageTag: 96a35b4d-0e1f-44ae-8165-a1f24f65d8f0
	sourceLineageTag: [dbo].[dq_results]

	/// Sort key for DQ rule severity: 1 = reject, 2 = warning, 3 = info, 9 = anything else.
	measure 'Severity Order' =
			
			SWITCH(MAX(dq_results[severity]), "reject", 1, "warning", 2, "info", 3, 9)
		formatString: 0
		displayFolder: Data Quality\Rules
		isHidden
		lineageTag: 679f3b1a-aa9c-4586-ab0b-7005f3e45707


{
  "_about": "PI-style simulated wellhead sensors (DEC-032). Every reading is simulated; the monthly volumes and hours in wells are real Petrinex values from gold_fact_production (a frozen snapshot). This is not AVEVA PI System.",
  "month": {
    "production_month": "2025-11",
    "timezone": "America/Edmonton",
    "expected_hours": 721
  },
  "seed": 20251101,
  "selection": {
    "products": [
      "OIL",
      "GAS"
    ],
    "min_hours": 600,
    "min_volume": {
      "OIL": 30,
      "GAS": 100
    },
    "facilities_per_product": 4,
    "wells_per_facility": 5,
    "seed": 20251101,
    "source": {
      "table": "gold_fact_production",
      "gold_run_id": "57f84a9c",
      "production_month": "2025-11"
    }
  },
  "af": {
    "root": "\\\\PI-style\\Alberta",
    "tag_name_pattern": "{facility_id}.{well_key}.{tag_code}"
  },
  "tags": [
    {
      "code": "TP",
      "attribute": "Tubing Pressure",
      "unit": "kPa",
      "kind": "analog",
      "physical_range": [0, 20000],
      "normal_range": [50, 10000],
      "frozen_check": true
    },
    {
      "code": "CP",
      "attribute": "Casing Pressure",
      "unit": "kPa",
      "kind": "analog",
      "physical_range": [0, 20000],
      "normal_range": [50, 10000],
      "frozen_check": true
    },
    {
      "code": "TEMP",
      "attribute": "Wellhead Temperature",
      "unit": "degC",
      "kind": "analog",
      "physical_range": [-50, 150],
      "normal_range": [-40, 90],
      "frozen_check": true
    },
    {
      "code": "FLOW_OIL",
      "attribute": "Oil Flow Rate",
      "unit": "m3/d",
      "kind": "analog",
      "product": "OIL",
      "physical_range": [0, 2000],
      "normal_range": [0, 1000],
      "frozen_check": true
    },
    {
      "code": "FLOW_GAS",
      "attribute": "Gas Flow Rate",
      "unit": "e3m3/d",
      "kind": "analog",
      "product": "GAS",
      "physical_range": [0, 500],
      "normal_range": [0, 200],
      "frozen_check": true
    },
    {
      "code": "RUN",
      "attribute": "Run Status",
      "unit": "state",
      "kind": "digital",
      "physical_range": [0, 1],
      "normal_range": [0, 1],
      "frozen_check": false
    }
  ],
  "generator": {
    "sample_interval_minutes": 60,
    "flow_hourly_noise_pct": 3.0,
    "normal_volume_bias_max_pct": 1.0,
    "pressure_kpa": {
      "OIL": {
        "tubing": 600,
        "casing": 1200
      },
      "GAS": {
        "tubing": 3000,
        "casing": 4500
      }
    },
    "pressure_noise_pct": 1.0,
    "shut_in_build_hours": 6,
    "temperature_degc": {
      "OIL": 35,
      "GAS": 20,
      "ambient": 0,
      "noise": 0.3,
      "cooling_hours": 6
    },
    "decimals": {
      "TP": 1,
      "CP": 1,
      "TEMP": 1,
      "FLOW_OIL": 3,
      "FLOW_GAS": 3,
      "RUN": 0
    }
  },
  "downtime": {
    "_note": "If Petrinex hours leave at least min_event_hours of the month unproduced, the simulated downtime equals 721 - Petrinex hours; otherwise random_total_hours. Split into events_per_well events.",
    "events_per_well": [1, 3],
    "min_event_hours": 2,
    "random_total_hours": [2, 12],
    "detect_min_hours": 2,
    "flow_off_below": {
      "OIL": 0.01,
      "GAS": 0.01
    },
    "lost_volume_lookback_hours": 24
  },
  "injections": {
    "_note": "Deliberate bad readings on analog tags in running hours. They replace the reading only; the true volume of the hour is unchanged.",
    "out_of_range_per_well": 2,
    "out_of_range_value": -9999.0,
    "frozen_runs_per_well": 1,
    "frozen_run_hours": 8,
    "missing_per_well": 6
  },
  "quality": {
    "states": [
      "Good",
      "Questionable",
      "Bad"
    ],
    "bad": [
      "outside physical_range",
      "missing reading (no data)"
    ],
    "questionable": [
      "outside normal_range",
      "frozen: the same value for frozen_min_points or more consecutive readings"
    ],
    "frozen_min_points": 6,
    "frozen_ignore_values": [
      0
    ]
  },
  "reconciliation": {
    "hourly_volume": "rate / 24 for a Good flow reading; 0 for an hour with a Good RUN = 0 reading; otherwise the mean Good flow rate of the running hours of the same local day / 24 (the month mean if that day has none)",
    "threshold_pct": 5.0
  },
  "anomaly_wells": {
    "_note": "Deliberately simulated differences between the sensor volume and the real Petrinex volume. Reconciliation is expected to flag exactly these wells: this tests the detection logic, it is not a finding about the real data.",
    "wells": [
      {"well_key": "100153106216W500", "volume_bias_pct": 15.0},
      {"well_key": "108082607606W402", "volume_bias_pct": -20.0},
      {"well_key": "100160407605W500", "volume_bias_pct": 25.0}
    ]
  },
  "stream": {
    "_note": "Live feed for Eventstream (DEC-033). late_pct and duplicate_pct are shares of the unique readings, sent late or twice on purpose. Delays are in samples.",
    "eventstream": "es_sensor_readings",
    "bronze_table": "bronze_sensor_readings",
    "connection_string_env": "SENSOR_EVENTHUB_CONNECTION_STRING",
    "source": "stream",
    "sample_interval_seconds": 60,
    "late_pct": 1.0,
    "late_delay_samples": [2, 5],
    "duplicate_pct": 1.0,
    "duplicate_delay_samples": [0, 1]
  },
  "layers": {
    "_note": "Tables and files of the sensor Silver and Gold notebooks (DEC-034).",
    "bronze_backfill_table": "bronze_sensor_backfill",
    "bronze_stream_table": "bronze_sensor_readings",
    "hierarchy_table": "sensor_asset_hierarchy",
    "silver_table": "silver_sensor_readings",
    "rejects_table": "sensor_silver_rejects",
    "quality_tests_table": "sensor_quality_test_results",
    "hourly_table": "gold_sensor_hourly",
    "downtime_table": "gold_downtime_events",
    "reconciliation_table": "gold_sensor_reconciliation",
    "production_fact_table": "gold_fact_production",
    "truth_file": "/lakehouse/default/Files/raw/sensor/backfill_2025-11_truth.json",
    "stream_manifests": "/lakehouse/default/Files/raw/sensor/stream_runs/stream_run_*.json"
  },
